[Unit]
Description=Smart jacket ML and fall detection
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 -u __DIR__/live_inference.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
